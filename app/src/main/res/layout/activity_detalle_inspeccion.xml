<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"/>


        <TextView
            android:id="@+id/tvDescripcionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"/>


        <TextView
            android:id="@+id/tvEstadoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"/>


        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="16dp">


            <Button
                android:id="@+id/btnEditarInspeccion"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Editar inspección"
                android:layout_marginTop="20dp"/>


            <Button
                android:id="@+id/btnEliminarInspeccion"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Eliminar inspección"
                android:layout_marginTop="20dp"/>


            <Button
                android:id="@+id/btnSubirFoto"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:text="Subir fotografía"/>


            <Button
                android:id="@+id/btnGrabarAudio"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Grabar audio"/>


            <Button
                android:id="@+id/btnDetenerAudio"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Detener audio"/>


            <Button
                android:id="@+id/btnSubirAudio"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Subir audio"/>


        </GridLayout>


        <EditText
            android:id="@+id/edtObservacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escriba una observación"/>


        <Button
            android:id="@+id/btnGuardarObservacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar observación"/>


        <TextView
            android:id="@+id/tvListaObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observaciones de la inspección:"
            android:textSize="16sp"/>


        <TextView
            android:id="@+id/tvListaAudios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audios:"
            android:textSize="16sp"
            android:layout_marginTop="20dp"/>


        <LinearLayout
            android:id="@+id/layoutAudios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>


        <ImageView
            android:id="@+id/imgFoto"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"/>


    </LinearLayout>


</ScrollView>